clear; close all; clc;

%% Import oscilloscope CSV files

script_dir = fileparts(mfilename('fullpath'));

unfiltered_filename = fullfile(script_dir, '..', ...
    'data', 'PWM60Hz_unfiltered.csv');

%filtered_filename = fullfile(script_dir, '..', '..', '..', ...
%    'data', 'oscilloscope', 'PWM60Hz_filtered.csv');

unfiltered = import_siglent_csv(unfiltered_filename);
%filtered   = import_siglent_csv(filtered_filename);

%% Signal parameters

f0 = 60;           % Expected 60Hz path sine frequency [Hz]
fPWM = 15625;      % Timer1 PWM frequency [Hz]

%% Extract data

t_pwm = unfiltered.time; % from us in the .CSV
v_pwm = unfiltered.voltage; % Volts

%t_filt = filtered.time;
%v_filt = filtered.voltage;

%% Figure 1 - Measured unfiltered PWM signal

figure;
plot(t_pwm*1000, v_pwm, 'LineWidth', 1.0);
grid on;

xlabel('Time [ms]');
ylabel('Voltage [V]');
title('Measured 60 Hz Unfiltered PWM Signal');

xlim([min(t_pwm)*1000 max(t_pwm)*1000]);


%% Figure 2 - Measured unfiltered PWM signal - zoom

figure;
plot(t_pwm*1000, v_pwm, 'LineWidth', 1.0);
grid on;

xlabel('Time [ms]');
ylabel('Voltage [V]');
title('Measured 60 Hz PWM Carrier - Zoom');

xlim([0 0.05]);   % 0.05 ms zoom


%% Figure 3 - FFT of measured unfiltered PWM signal

N_pwm = length(v_pwm);
V_pwm_fft = fft(v_pwm);

V_pwm_mag = abs(V_pwm_fft(1:floor(N_pwm/2)+1));
f_scope = (0:floor(N_pwm/2)) * unfiltered.fs / N_pwm;

V_pwm_mag = V_pwm_mag / max(V_pwm_mag);
V_pwm_mag_dB = 20*log10(V_pwm_mag + eps);

figure;
plot(f_scope, V_pwm_mag_dB, 'LineWidth', 1.2);
grid on;

xlabel('Frequency [Hz]');
ylabel('Normalized Magnitude [dB]');
title('FFT of Measured 60 Hz Unfiltered PWM Signal');

xline(f0, ':', sprintf('Signal = %.0f Hz', f0));
xline(fPWM, ':', sprintf('f_{PWM} = %.0f Hz', fPWM));

xlim([0 50000]);
ylim([-100 5]);


%% Figure 4 - FFT of measured unfiltered PWM signal - low frequency zoom

figure;
plot(f_scope, V_pwm_mag_dB, 'LineWidth', 1.2);
grid on;

xlabel('Frequency [Hz]');
ylabel('Normalized Magnitude [dB]');
title('FFT of Measured 60 Hz Unfiltered PWM Signal - Low Frequency Zoom');

xline(f0, ':', sprintf('Signal = %.0f Hz', f0));
xline(fPWM, ':', sprintf('f_{PWM} = %.0f Hz', fPWM));

xlim([0 1000]);
ylim([-100 5]);